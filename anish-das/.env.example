PORT=5000
NODE_ENV=development
JWT_SECRET=replace_with_a_strong_random_jwt_secret
JWT_EXPIRATION=8h
CORS_ORIGIN=http://localhost:5173
MONGODB_BASE_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net
UPSTASH_REDIS_REST_URL=https://<your-endpoint>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<your_upstash_redis_rest_token>
DEFAULT_ADMIN_PASSWORD=replace_with_admin_password
MASTER_ADMIN_PIN=replace_with_admin_pin

