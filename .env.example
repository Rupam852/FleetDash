# Server Configuration
PORT=4000
NODE_ENV=development

# MongoDB Connection (Optimized for Bucket Pattern)
MONGODB_URI=mongodb://localhost:27017/fleetdash

# Redis Configuration (Pub/Sub & Event Broker)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Telemetry & Worker Configuration
WORKER_POOL_SIZE=4
INGESTION_BATCH_SIZE=250
BUCKET_SIZE_LIMIT=3600

# Client Configuration
VITE_API_URL=http://localhost:4000
VITE_SOCKET_URL=http://localhost:4000

